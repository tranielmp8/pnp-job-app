# Drizzle
# Replace with your DB credentials!
DATABASE_URL="postgres://user:password@host:port/db-name"

ORIGIN=""

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# Job providers to use, comma-separated: jsearch, adzuna (default: jsearch)
JOB_PROVIDERS="jsearch"
# Each provider is also skipped when its keys are empty
# https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
RAPIDAPI_KEY=""
# https://developer.adzuna.com/
ADZUNA_APP_ID=""
ADZUNA_API_KEY=""

# Resume file uploads:
#   "none"  (default) links only, uploads hidden
#   "local" files in UPLOAD_DIR (needs a persistent disk, so NOT on Netlify)
#   "s3"    an S3-compatible bucket, e.g. a Railway bucket (use this on Netlify)
STORAGE_DRIVER="none"
UPLOAD_DIR="./uploads"

# For STORAGE_DRIVER="s3". Copy these from the Railway bucket's Credentials tab.
S3_BUCKET=""
S3_ENDPOINT=""
S3_REGION="auto"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Set to "true" only if your provider needs path-style URLs (e.g. MinIO).
S3_FORCE_PATH_STYLE="false"
