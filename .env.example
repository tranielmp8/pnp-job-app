# Drizzle
# Replace with your DB credentials!
DATABASE_URL="postgres://user:password@host:port/db-name"

ORIGIN=""

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# Job providers to use, comma-separated: jsearch, adzuna (default: jsearch)
JOB_PROVIDERS="jsearch"
# Each provider is also skipped when its keys are empty
# https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
RAPIDAPI_KEY=""
# https://developer.adzuna.com/
ADZUNA_APP_ID=""
ADZUNA_API_KEY=""

# Resume storage. In Coolify, mount a persistent volume at this path.
UPLOAD_DIR="./uploads"

# Resume file uploads: "none" (links only, default) or "local" (files in UPLOAD_DIR).
# An "s3" driver will be added once the storage bucket exists.
STORAGE_DRIVER="none"
